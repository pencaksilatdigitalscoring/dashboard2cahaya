    <header>
        <h2 id="header-text">Cahaya Digital Sport</h2>
        <img id="header-img-logo" src="" alt="Cahaya Digital Sport Banner">
    </header>

    <nav class="navbar">
        <ul id="nav-menu">
            <li id="menu-beranda" class="active" onclick="bukaBeranda()">Beranda</li>
        </ul>
    </nav>

    <div class="container">
        <div id="beranda-view">
            <h2 class="section-title">Berita Terbaru</h2>
            <div id="beranda-grid" class="post-grid"><div class="loading">Memuat berita terbaru...</div></div>
            <div id="beranda-pagination" class="pagination"></div>
        </div>

        <div id="dynamic-view">
            <h2 id="dynamic-title" class="section-title">Nama Menu</h2>
            <div id="dynamic-kontak-wrapper" style="display: none;">
                <p id="dyn-kontak-pesan"></p>
                <div id="dyn-kontak-sosmed" class="sosmed-container"></div>
            </div>
            <div id="dynamic-berita-wrapper" style="display: none;">
                <div id="dynamic-berita-grid" class="post-grid"></div>
                <div id="dynamic-berita-pagination" class="pagination"></div>
            </div>
            <div id="dynamic-galeri-wrapper" style="margin-top: 40px; display: none;">
                <h3 style="font-size: 1.2rem; margin-bottom: 15px; color:#333;">Galeri Foto</h3>
                <div id="dynamic-galeri-grid" class="gallery-grid"></div>
            </div>
        </div>

        <div id="detail-view">
            <button class="btn-kembali" onclick="tutupDetail()">⬅ Kembali</button>
            <h1 id="detail-judul">Judul Berita</h1>
            <span id="detail-waktu"></span>
            <img id="detail-img" src="" alt="Gambar Detail">
            <div id="detail-text"></div>
        </div>
    </div>

